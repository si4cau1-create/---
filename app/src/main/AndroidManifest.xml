<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 唯一权限：调用大模型 API 需要网络。拍照走系统相机 Intent（无需 CAMERA 权限），
         备份导出走 MediaStore（Q+）或应用外部目录（无需存储权限）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 给系统相机提供拍照输出文件的 ContentProvider -->
        <provider
            android:name=".WebAssetProvider"
            android:authorities="com.kadian.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
